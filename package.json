{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "hexo clean && hexo generate && pagefind --site public",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "postinstall": "patch-package",
    "server": "hexo server",
    "test": "node tests/reading-index-filter.test.js && node tests/bibliography.test.js",
    "test:toc": "node tests/toc.test.js"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "@citation-js/core": "0.7.18",
    "@citation-js/plugin-bibtex": "0.7.18",
    "@citation-js/plugin-csl": "0.7.18",
    "dom-serializer": "0.1.1",
    "domutils": "1.4.3",
    "hexo": "^7.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-feed": "^1.1.2",
    "hexo-filter-tikzjax": "^1.0.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-knowledge-graph": "^0.3.2",
    "hexo-pdf": "^1.1.1",
    "hexo-reference": "^1.0.4",
    "hexo-renderer-aether": "^0.0.6",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-shokax": "^0.5.4",
    "htmlparser2": "3.8.3",
    "nyx-player": "^0.1.1",
    "shokax-uikit": "0.0.5"
  },
  "overrides": {
    "rollup-plugin-visualizer": "7.0.1"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "patch-package": "^8.0.1"
  }
