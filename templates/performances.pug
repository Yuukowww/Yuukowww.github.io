extends page.pug

block content
    section.page.wrap.performances(aria-label="我的演奏" data-performances data-pagefind-body)
        p.performances-intro 短短副歌
        if !page.tracks.length
            p.performances-empty 这里还没有演奏录音，待下一次琴声响起。
        else
            div.performance-list
                each track in page.tracks
                    article.performance-card(data-src=url_for(track.src))
                        div.performance-heading
                            button.performance-toggle(type="button" aria-label=`播放：${track.title}` aria-pressed="false")
                                span(aria-hidden="true") ▶
                            div
                                h2.performance-title= track.title
                                p.performance-meta
                                    if track.instrument
                                        span= track.instrument
                                    if track.date
                                        time= typeof track.date === 'string' ? track.date : date(track.date, 'YYYY-MM-DD')
                        if track.description
                            p.performance-description= track.description
                        div.performance-timeline
                            input.performance-seek(type="range" min="0" max="100" value="0" step="0.1" disabled aria-label=`播放进度：${track.title}`)
                            span.performance-time 00:00 / --:--
                        p.performance-status(role="status" aria-live="polite")
